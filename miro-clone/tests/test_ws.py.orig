import os
import pytest
os.environ["TESTING"] = "1"
import asyncio
from fastapi.testclient import TestClient

from src.main import app
from src.database import Base, engine, AsyncSessionLocal
from src.models import Board
import json
from src.auth import create_access_token

@pytest.fixture(scope="module", autouse=True)
def setup_test_env():
    os.environ["TESTING"] = "1"
    yield
    os.environ.pop("TESTING", None)

@pytest.fixture(scope="module")
def setup_db_sync():
    """Setup a shared database for synchronous test execution."""
    async def init_db():
        async with engine.begin() as conn:
            await conn.run_sync(Base.metadata.create_all)

    # Run the init DB function
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    loop.run_until_complete(init_db())

    yield

    async def drop_db():
        async with engine.begin() as conn:
            await conn.run_sync(Base.metadata.drop_all)

    loop.run_until_complete(drop_db())
    loop.close()

def test_websocket_manager(setup_db_sync):
    """Test standard websocket manager logic."""
    with TestClient(app) as client:
        with client.websocket_connect("/ws/default/ws_user") as websocket:
            websocket.receive_text()

@pytest.mark.asyncio
async def test_board_access_control(setup_db_sync):
    import uuid
    board_id = str(uuid.uuid4())
    token = create_access_token({"sub": "owner_user"})

    # create board explicitly with owner
    async with AsyncSessionLocal() as session:
        new_board = Board(id=board_id, owner_username="owner_user", public_access="view")
        session.add(new_board)
        await session.commit()

    # owner can edit
    with TestClient(app) as client:
        with client.websocket_connect(f"/ws/{board_id}/owner_user?token={token}") as ws:
            init_msg = ws.receive_text()
            assert '"permission":"edit"' in init_msg

    # non-owner is view-only (no token or different token)
    other_token = create_access_token({"sub": "other_user"})
    with TestClient(app) as client:
        with client.websocket_connect(f"/ws/{board_id}/other_user?token={other_token}") as ws:
            init_msg = ws.receive_text()
            assert '"permission":"view"' in init_msg

            # send edit message
            ws.send_text(json.dumps({"type": "update", "id": "1", "data": {}}))
            # it should be ignored (no broadcast back)
